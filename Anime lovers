function getRandomAnimeCharacter() {
    const anime = animeData[Math.floor(Math.random() * animeData.length)];
    const form = anime.forms[Math.floor(Math.random() * anime.forms.length)];
    return {
        type: "anime",
        name: anime.name,
        variant: form.variant,
        animation: form.animation,
        stars: form.stars,
        shiny: false
    };
}

