const { default: makeWASocket, useSingleFileAuthState } = require("@whiskeysockets/baileys");
const fs = require("fs");
const axios = require("axios");
const cron = require("node-cron");
const { Boom } = require("@hapi/boom");

const { state, saveState } = useSingleFileAuthState("./auth.json");

const pokemonList = [
    "Pikachu", "Charizard", "Bulbasaur", "Gengar", "Lucario", "Eevee", "Snorlax"
];

const animeCharacters = [
    { name: "Naruto Uzumaki", stars: 5 },
    { name: "Sasuke Uchiha", stars: 6 },
    { name: "Goku", stars: 7 },
    { name: "Levi Ackerman", stars: 6 },
    { name: "Gojo Satoru", stars: 7 },
    { name: "Deku", stars: 4 },
    { name: "Itadori Yuji", stars: 5 }
];

const specialVariants = [
    "Christmas outfit", "Battle armor", "Festival kimono", "Dark form", "Ultra Instinct", "Hero costume"
];

function getRandomElement(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
}

function generateDrop() {
    let dropType = Math.random() < 0.5 ? "pokemon" : "anime";
    if (dropType === "pokemon") {
        let pokemon = getRandomElement(pokemonList);
        return `A wild *${pokemon}* appeared! Type \`catch ${pokemon.toLowerCase()}\` to claim it!`;
    } else {
        let base = getRandomElement(animeCharacters);
        let isSpecial = Math.random() < 0.2; // 20% chance for a special variant
        let stars = isSpecial ? 8 : base.stars;
        let specialTag = isSpecial ? ` (${getRandomElement(specialVariants)})` : "";
        return `A ${stars}★ anime character appeared!\n*${base.name}*${specialTag}\nType \`claim ${base.name.toLowerCase()}\` to collect!`;
    }
}

async function startBot() {
    const sock = makeWASocket({
        auth: state,
        printQRInTerminal: true
    });

    sock.ev.on("creds.update", saveState);

    // Send random drops every 1 to 5 minutes
    setInterval(() => {
        let message = generateDrop();
        // Replace this with your target group or user ID
        let chatId = "120xxxxxxxxxx@g.us"; // <- insert your group ID
        sock.sendMessage(chatId, { text: message });
    }, Math.floor(Math.random() * 4 + 1) * 60000); // Random interval (1-5 minutes)

    sock.ev.on("messages.upsert", async ({ messages }) => {
        const msg = messages[0];
        if (!msg.message || msg.key.fromMe) return;

        const text = msg.message.conversation?.toLowerCase();
        if (text?.startsWith("catch ")) {
            const name = text.replace("catch ", "").trim();
            await sock.sendMessage(msg.key.remoteJid, {
                text: `You caught *${name.charAt(0).toUpperCase() + name.slice(1)}*!`,
            });
        } else if (text?.startsWith("claim ")) {
            const name = text.replace("claim ", "").trim();
            await sock.sendMessage(msg.key.remoteJid, {
                text: `You claimed *${name.charAt(0).toUpperCase() + name.slice(1)}*!`,
            });
        }
    });
}

startBot();
