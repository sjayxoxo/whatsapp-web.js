function isShinyTime() {
    const now = new Date();
    const hours = now.getHours();
    const minutes = now.getMinutes();

    // Shiny spawn times: 3:00 AM–4:30 AM, 11:11 PM, Full Moon
    if ((hours === 3 && minutes >= 0 && minutes <= 30) || hours === 23 && minutes === 11) {
        return true;
    }
    return false;
}

