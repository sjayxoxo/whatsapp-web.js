module.exports = function catchPokemon(args, playerId, playerName, playerDB, saveDB) {
    // Expecting the player to type `!catch <pokemon_name>`
    const pokemonName = args.join(" ");
    if (!pokemonName) {
        console.log(`${playerName} tried to catch a Pokémon without specifying a name.`);
        return;
    }

    const drop = JSON.parse(fs.readFileSync("data/currentDrop.json"));

    if (drop.type !== "pokemon" || drop.name.toLowerCase() !== pokemonName.toLowerCase()) {
        console.log(`${playerName} tried to catch a wrong Pokémon: ${pokemonName}.`);
        return;
    }

    const player = playerDB.players[playerId];
    const alreadyCaught = player.caught.some(p => p.name.toLowerCase() === drop.name.toLowerCase());

    if (alreadyCaught) {
        console.log(`${playerName} has already caught ${drop.name}.`);
        return;
    }

    player.caught.push({ name: drop.name, stars: drop.stars });
    updatePlayerStats(playerId, playerDB);
    saveDB(playerDB);

    console.log(`${playerName} caught ${drop.name}!`);
};

