    }
    const data = fs.readFileSync(dbPath);
    return JSON.parse(data);
}

function saveDB(db) {
    fs.writeFileSync(dbPath, JSON.stringify(db, null, 2));
}

function getPlayer(playerId, db) {
    if (!db.players[playerId]) {
        db.players[playerId] = { 
            name: "Unknown", 
            caught: [], 
            claimed: [], 
            stats: { total_pokemon: 0, total_anime: 0, eight_star_anime: 0, total_stars: 0 }
        };
    }
    return db.players[playerId];
}

function updatePlayerStats(playerId, db) {
    const player = db.players[playerId];
    player.stats.total_pokemon = player.caught.length;
    player.stats.total_anime = player.claimed.length;
    player.stats.total_stars = player.caught.reduce((sum, p) => sum + p.stars, 0) + player.claimed.reduce((sum, a) => sum + a.stars, 0);
    player.stats.eight_star_anime = player.claimed.filter(a => a.stars === 8).length;
}

module.exports = { loadDB, saveDB, getPlayer, updatePlayerStats };

module.exports = function catchPokemon(args, playerId, playerName, playerDB, saveDB) {
    const drop = JSON.parse(fs.readFileSync("data/currentDrop.json"));
    if (drop.type !== "pokemon") return;

    const player = playerDB.players[playerId];
    const alreadyCaught = player.caught.some(p => p.name === drop.name);
    if (alreadyCaught) {
        console.log(`${playerName} has already caught ${drop.name}`);
        return;
    }

    player.caught.push({ name: drop.name, stars: drop.stars });
    updatePlayerStats(playerId, playerDB);
    saveDB(playerDB);

