const { default: makeWASocket, useSingleFileAuthState } = require("@whiskeysockets/baileys");
const fs = require("fs");
const axios = require("axios");

const { state, saveState } = useSingleFileAuthState("./auth.json");

const pokemonList = require("./pokemon_full.json");
const animeCharacters = require("./anime_characters.json");

const specialVariants = [
    "Christmas Outfit", "Battle Armor", "Festival Kimono",
    "Dark Form", "Ultra Instinct", "Hero Costume", "Samurai Armor"
];

function getRandomElement(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
}

function generateDrop() {
    let dropType = Math.random() < 0.5 ? "pokemon" : "anime";
    if (dropType === "pokemon") {
        let p = getRandomElement(pokemonList);
        return {
            text: `A wild ${p.stars}★ *${p.name}* appeared!\nType \`catch ${p.name.toLowerCase()}\` to claim it!`,
            image: p.image
        };
    } else {
        let base = getRandomElement(animeCharacters);
        let isSpecial = Math.random() < 0.15;
        let stars = isSpecial ? 8 : base.stars;
        let outfit = isSpecial ? ` (${getRandomElement(specialVariants)})` : "";
        return {
            text: `${stars}★ Anime character appeared!\n*${base.name}*${outfit}\nType \`claim ${base.name.toLowerCase()}\`!`,
            image: base.image
        };
    }
}

async function startBot() {
    const sock = makeWASocket({
        auth: state,
        printQRInTerminal: true
    });

    sock.ev.on("creds.update", saveState);

    // Random drops every 1 to 5 minutes
    setInterval(() => {
        let drop = generateDrop();
        let chatId = "120XXXXXXXX@g.us"; // Replace with your group ID
        sock.sendMessage(chatId, {
            image: { url: drop.image },
            caption: drop.text
        });
    }, Math.floor(Math.random() * 4 + 1) * 60000);

    sock.ev.on("messages.upsert", async ({ messages }) => {
        const msg = messages[0];
        if (!msg.message || msg.key.fromMe) return;

        const text = msg.message.conversation?.toLowerCase();
        if (text?.startsWith("catch ")) {
            const name = text.replace("catch ", "").trim();
            await sock.sendMessage(msg.key.remoteJid, {
                text: `You caught *${name.charAt(0).toUpperCase() + name.slice(1)}*!`
            });
        } else if (text?.startsWith("claim ")) {
            const name = text.replace("claim ", "").trim();
            await sock.sendMessage(msg.key.remoteJid, {
                text: `You claimed *${name.charAt(0).toUpperCase() + name.slice(1)}*!`
            });
        }
    });
}

